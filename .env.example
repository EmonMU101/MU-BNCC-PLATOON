# =============================================================================
# MU BNCC Official Portal - Environment Configuration Template
# Copy this file to .env or .env.local for local development.
# NEVER commit sensitive API keys or .env files containing real secrets to Git!
# =============================================================================

# Server & Hosting Environment
NODE_ENV="production"
PORT=3000
APP_URL="https://your-domain.com"
ALLOWED_ORIGINS="https://your-domain.com,https://ais-dev-y7jn6emym5sgrkbk4bfwst-929416681930.asia-southeast1.run.app"

# AI Studio / Gemini API Integration
# Runtime secret injected automatically or configured via AI Studio Secrets Panel
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Firebase Client Configuration (Vite client-side environment variables)
# Provide these in .env.local to keep firebase-applet-config.json blank or out of version control
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-mubnccofficialpo-..."
VITE_FIREBASE_OAUTH_CLIENT_ID="123456789012-xxx.apps.googleusercontent.com"
